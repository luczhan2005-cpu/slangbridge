# Copy this file to .env and fill in ONE provider. Never commit .env.

# --- Option A: Anthropic Claude (default) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5      # cheaper alternative: claude-haiku-5-5
# CLAUDE_EFFORT=medium              # low | medium | high

# --- Option B: any OpenAI-compatible API (works from mainland China) ---
# LLM_PROVIDER=openai-compatible
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1         # DeepSeek
# OPENAI_COMPAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # Qwen (Alibaba)
# OPENAI_COMPAT_MODEL=deepseek-chat                           # or qwen-plus

# PORT=3000
# RATE_LIMIT_PER_10MIN=150
